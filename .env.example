# Copy to .env for local development. .env is gitignored and dockerignored.
#
# Every value here is SERVER-SIDE ONLY. None of these may ever be exposed to the
# browser bundle — no VITE_ prefix, no client-side fetch, not even for local dev.
# Vite inlines any VITE_* variable into the built JavaScript.
#
# In production these come from `fly secrets set`, not from this file.

# --- Secrets (fly secrets set ...) ---
ANTHROPIC_API_KEY=sk-ant-...
FINNHUB_API_KEY=
# openssl rand -hex 32
SESSION_SECRET=
# Passphrase for the single-user login
APP_PASSPHRASE=

# --- Config (fly.toml [env] in production) ---
PORT=8080
# Local path; on Fly this is /data/ticker.db on the mounted volume.
DB_PATH=./ticker.db

# --- Optional ---
# claude-sonnet-5 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5
LOG_LEVEL=info
